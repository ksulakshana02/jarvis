# Gemini key: only needed for MODE=live, LLM_BACKEND/LLM_FALLBACK=gemini, or TTS_ENGINE=gemini
# Get one: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

ASSISTANT_NAME=Jarvis
USER_NAME=Isuru

# ---------------------------------------------------------------- MODE
# lite = "Hey Jarvis" wake word + local speech-to-text + local voice.
#        Only ONE small Gemini text call per command -> fits the free tier.
# live = Gemini Live real-time streaming. Best feel, but burns quota fast.
MODE=lite

# ---------------------------------------------------------------- lite mode
# Brain: ollama = local LLM, free, offline, no quota (default)
#        openai = any OpenAI-compatible server (LM Studio, llama.cpp, Groq, OpenRouter)
#        gemini = Google Flash-Lite (quota)
LLM_BACKEND=ollama
LLM_FALLBACK=gemini           # used if the main brain fails (e.g. Ollama not running)

# Ollama models (pick by your RAM, CPU-only works):
#   qwen3:1.7b  ~1.4 GB  fastest, ok for simple commands
#   qwen3:4b    ~2.5 GB  good tool calling, recommended   <- default
#   llama3.1:8b ~4.9 GB  smarter, needs 8 GB+ RAM or a GPU
#   gemma3:4b   ~3.3 GB  can SEE the screen (set LLM_VISION=true)
OLLAMA_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
# false = start listening immediately; true = load the model before ready
WARMUP_BRAIN=false
LLM_VISION=false

# OpenAI-compatible example (LM Studio):  OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# Groq free cloud API (fast):              OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                                          OPENAI_API_KEY=gsk_...   OPENAI_MODEL=<model id from console.groq.com>
OPENAI_BASE_URL=http://127.0.0.1:1234/v1
OPENAI_API_KEY=
OPENAI_MODEL=local-model

# Gemini text (used when LLM_BACKEND=gemini or as fallback)
TEXT_MODEL=gemini-3.5-flash-lite
TEXT_FALLBACKS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.5-flash
WAKE_WORD=hey_jarvis          # hey_jarvis | alexa | hey_mycroft | hey_marvin
WAKE_THRESHOLD=0.5            # lower = triggers easier (0.3-0.7)
WHISPER_MODEL=base.en         # tiny.en = fastest, small.en = most accurate
STT_LANGUAGE=en
TTS_ENGINE=piper              # piper = free offline voice, gemini = uses quota
PIPER_VOICE=en_GB-alan-medium # British male. Others: en_US-ryan-high, en_GB-northern_english_male-medium
FOLLOWUP_SECONDS=6            # after it answers, talk again without the wake word
END_SILENCE_MS=800            # pause length that ends your sentence
VAD_MIN_RMS=400               # raise if background noise keeps it listening

# ---------------------------------------------------------------- live mode
# Real-time model + its built-in voice (Puck, Charon, Kore, Fenrir, Aoede, Zephyr, ...)
LIVE_MODEL=gemini-3.8-live
# used automatically if the model above hits its quota
LIVE_FALLBACKS=gemini-3.1-flash-live-preview,gemini-2.5-flash-native-audio-preview-12-2025
LIVE_VOICE=Charon

# native = Live model speaks directly (fastest, recommended)
# tts    = Live model's words are re-voiced by the Gemini TTS model below (custom style, ~1s slower)
VOICE_MODE=native

# Gemini TTS (greeting, timers, and VOICE_MODE=tts). WAV files cached in voice_cache/
TTS_MODEL=gemini-3.8-flash-lite-tts
TTS_VOICE=Charon
TTS_STYLE=calm, confident, slightly British butler

# false = mic pauses while assistant talks (speakers). true = interrupt anytime (headphones)
BARGE_IN=false

# Let the assistant run PowerShell commands (always asks you first)
ALLOW_SHELL=false

UI_PORT=8765
HOTKEY=ctrl+alt+j   # Windows only; on Linux see README (GNOME custom shortcut)
